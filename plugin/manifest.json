{
  "manifestVersion": 6,
  "id": "com.cortesai.panel",
  "name": "CortesAI",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "cortesai.main",
      "label": {
        "default": "CortesAI"
      },
      "minimumSize": { "width": 320, "height": 420 },
      "maximumSize": { "width": 1200, "height": 2000 },
      "preferredDockedSize": { "width": 380, "height": 720 },
      "preferredFloatingSize": { "width": 420, "height": 780 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "allowCodeGenerationFromStrings": false
  },
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/icon.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light"]
    }
  ]
}
